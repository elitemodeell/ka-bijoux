        "EXPO_PUBLIC_AUTH_GOOGLE_ENABLED": "true"
      }
    },
    "preview": {
      "node": "20.19.4",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_DISTRIBUTION": "GOOGLE_PLAY",
        "EXPO_PUBLIC_API_URL": "https://kabijoux.com.br",
