# ═══════════════════════════════════════════════════════════════
#  KA Bijoux Mobile — Variáveis de Ambiente
#  Copie para .env e preencha conforme o ambiente.
# ═══════════════════════════════════════════════════════════════

# URL da API do backend
# Em desenvolvimento local: use o IP da sua máquina na rede local
#   Ex: http://192.168.1.100:3000
# Em produção: use a URL do Vercel
EXPO_PUBLIC_API_URL="https://kabijoux.com.br"
EXPO_PUBLIC_SITE_URL="https://kabijoux.com.br"

# Supabase Auth (a publishable/anon key is public by design, never use service_role here)
EXPO_PUBLIC_SUPABASE_URL="https://sxohqngzypmxtmuulfoa.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Google permanece visível apenas quando a integração real está habilitada.
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED="true"

# Permite ocultar o Google em uma distribuição específica.
EXPO_PUBLIC_AUTH_HIDE_GOOGLE="false"

# Apple é obrigatório no build iOS quando há outro login social. O fluxo nativo
# usa o bundle identifier; não coloque client secret ou chave .p8 no aplicativo.
EXPO_PUBLIC_AUTH_APPLE_DISABLED="false"
