# ═══════════════════════════════════════════════════════════════
#  KA Bijoux — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA suba o arquivo .env para o repositório.
# ═══════════════════════════════════════════════════════════════

# ─── Banco de Dados (Supabase) ──────────────────────────────────────────────
#
# Ambas as URLs são obtidas no Supabase:
#   Dashboard → Settings → Database → Connection string
#
# DATABASE_URL → use uma URL do Connection Pooler.
# DIRECT_URL → use uma URL de conexão direta, apenas para migrations.
#
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-POOLER:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST-DIRETO:5432/postgres"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Autenticação / JWT ─────────────────────────────────────────────────────
# Gere strings aleatórias seguras (mínimo 32 caracteres).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://kabijoux.com.br"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
SUPABASE_AUTH_TRANSITION_ENABLED="false"
SUPABASE_AUTH_LEGACY_JWT_ACCEPT_UNTIL=""
AUTH_MIGRATION_ALLOW_WRITE="false"

# ─── URL pública do app ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://kabijoux.com.br"

# ─── E-mail transacional ─────────────────────────────────────────────────────
# Recuperação e exclusão pública falham de forma segura sem Resend. As
# variáveis são exclusivas do backend; nunca use prefixos NEXT_PUBLIC_ ou
# EXPO_PUBLIC_ para chaves e segredos.
RESEND_API_KEY=""
EMAIL_FROM="KA Bijoux <adm@kabijoux.com.br>"
EMAIL_REPLY_TO="adm@kabijoux.com.br"

# ─── Pagamentos (Asaas — único provedor ativo) ──────────────────────────────
# Use Sandbox durante desenvolvimento e homologação.
# A API key e o token do webhook são segredos distintos e exclusivos do backend.
PAYMENT_DEFAULT_PROVIDER="ASAAS"
PAYMENT_PIX_PROVIDER="ASAAS"
PAYMENT_CARD_PROVIDER="ASAAS"
PAYMENT_BOLETO_PROVIDER="ASAAS"
# Compatibilidade temporária; remover depois que todos os ambientes usarem as
# quatro variáveis acima.
PAYMENT_PROVIDER="ASAAS"
ASAAS_ENVIRONMENT="sandbox"
# Credencial exclusiva da conta Asaas oficial da KA Bijoux. Nunca reutilize a
# chave da Elite Modell, do Zuno ou de qualquer outra empresa.
ASAAS_API_KEY=""
# Barreira fail-closed: os trÃªs valores precisam corresponder ao retorno de
# /myAccount/commercialInfo/ e /wallets/ da conta oficial autenticada.
ASAAS_EXPECTED_LEGAL_NAME="KABIJOUX LTDA"
ASAAS_EXPECTED_CPF_CNPJ=""
ASAAS_EXPECTED_WALLET_ID=""
# Token exclusivo do webhook KA Bijoux em /api/webhooks/asaas. NÃ£o compartilhe
# este token com webhooks de outros projetos ou com a rota legada.
ASAAS_WEBHOOK_TOKEN=""
ASAAS_PIX_ENABLED="true"
ASAAS_CREDIT_CARD_ENABLED="true"
ASAAS_BOLETO_ENABLED="true"
ASAAS_MAX_INSTALLMENTS="3"
PAYMENT_PIX_DUE_DAYS="1"
PAYMENT_BOLETO_DUE_DAYS="3"
PAYMENT_CHECKOUT_EXPIRATION_MINUTES="60"
PAYMENT_CHECKOUT_RETURN_URL="https://kabijoux.com.br"

# ─── Melhor Envio (Correios) ─────────────────────────────────────────────────
# Sem token, PAC/SEDEX ficam indisponíveis; nenhum preço fictício é retornado.
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_SANDBOX="true"

# ─── Upload de Imagens (Cloudinary) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Expo Push Notifications ─────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=""

# ─── Desenvolvimento local ───────────────────────────────────────────────────
NODE_ENV="development"
# Supabase público para o navegador (anon/publishable key; nunca service role).
NEXT_PUBLIC_SUPABASE_URL=''
NEXT_PUBLIC_SUPABASE_ANON_KEY=''
